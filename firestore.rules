rules_version = '2';
// BusinessBI — Firestore аюулгүй байдлын дүрэм
// Deploy: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.email == 'khongor95@gmail.com'; }
    function str(v, max) { return v is string && v.size() <= max; }

    // Холбоо барих / хүлээлгийн жагсаалтын хүсэлт: хэн ч (нэвтрээгүй ч) үүсгэж болно,
    // зөвхөн админ уншина/засна. Талбарын урт хязгаарлагдсан (spam-аас хамгаалах).
    match /leads/{id} {
      allow create: if str(request.resource.data.name, 120)
                    && str(request.resource.data.phone, 30)
                    && str(request.resource.data.email, 120)
                    && str(request.resource.data.topic, 40)
                    && str(request.resource.data.message, 3000)
                    && request.resource.data.keys().hasOnly(['name','phone','email','topic','topicText','message','page','ua','status','createdAt']);
      allow read, update, delete: if isAdmin();
    }

    // Хэрэгслийн үйлдлийн лог: нэвтэрсэн хэрэглэгч зөвхөн өөрийн нэрээр нэмнэ; админ уншина
    match /activityLogs/{id} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // Төлбөр: зөвхөн сервер (Functions, admin SDK) бичнэ; хэрэглэгч өөрийнхөө бичлэгийг уншина
    match /payments/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }
    match /paymentEvents/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Бусад бүх зүйл хаалттай
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
