# functions/.env  (энэ файлыг .env гэж хуулж бөглөнө; .env нь git-д орохгүй)
# Горим: mock = WIRE-гүйгээр тест хуудсаар турших | live = жинхэнэ WIRE.mn
WIRE_MODE=mock
# Сайтын үндсэн хаяг — төлбөрийн дараа буцаах pay_done.html энд байрлана
SITE_URL=https://businessbi.mn
# WIRE API үндсэн хаяг (docs.wire.mn-ээс баталгаажуулах; өөр бол энд засна)
WIRE_BASE_URL=https://api.wire.mn/v1

# НУУЦ УТГУУДЫГ .env-д БИЧИХГҮЙ — Secret Manager-т хадгална:
#   firebase functions:secrets:set WIRE_SECRET_KEY
#   firebase functions:secrets:set WIRE_WEBHOOK_SECRET
